{
  "buildCommand": "npm ci --prefix frontend && npm run build:operations --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/gatewaynexus(.*)",
      "destination": "/operations/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
